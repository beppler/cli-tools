#!/usr/bin/env bash
# Runs Claude Code in an isolated container.
# Engine: Apple `container` on macOS, Podman on Linux.
set -euo pipefail

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  ENGINE=podman ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

HOME_DIR="$HOME/.cli-tools/claude-home"
mkdir -p "$HOME_DIR"

ENV_ARGS=()

if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  ENV_ARGS+=(-e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY")
fi

"$ENGINE" run --rm -it \
  -v "$PWD":/workspace -w /workspace \
  -v "$HOME_DIR":/root \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  claude-cli "$@"
