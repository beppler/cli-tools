#!/usr/bin/env bash
# Runs Gemini CLI in an isolated container.
# Engine: Apple `container` on macOS, Podman on Linux.
set -euo pipefail

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  ENGINE=podman ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

HOME_DIR="$HOME/.cli-tools/gemini-home"
mkdir -p "$HOME_DIR"

ENV_ARGS=()

if [ -n "${GEMINI_API_KEY:-}" ]; then
  ENV_ARGS+=(-e GEMINI_API_KEY="${GEMINI_API_KEY}")
fi

if [ -n "${GOOGLE_API_KEY:-}" ]; then
  ENV_ARGS+=(-e GOOGLE_API_KEY="${GOOGLE_API_KEY}")
fi

if [ -n "${GOOGLE_GENAI_USE_VERTEXAI:-}" ]; then
  ENV_ARGS+=(-e GOOGLE_GENAI_USE_VERTEXAI="${GOOGLE_GENAI_USE_VERTEXAI}")
fi


"$ENGINE" run --rm -it \
  -v "$PWD":/workspace -w /workspace \
  -v "$HOME_DIR":/root \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  gemini-cli-cli "$@"
