#!/usr/bin/env bash
# Runs Codex CLI in an isolated container.
# Engine: Apple `container` on macOS, Podman on Linux.
set -euo pipefail

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  ENGINE=podman ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

HOME_DIR="$HOME/.cli-tools/codex-home"
mkdir -p "$HOME_DIR"

ENV_ARGS=()

if [ -n "${TERM:-}" ]; then
  ENV_ARGS+=(-e TERM="$TERM")
fi

if [ -n "${COLORTERM:-}" ]; then
  ENV_ARGS+=(-e COLORTERM="$COLORTERM")
fi

if [ -n "${OPENAI_API_KEY:-}" ]; then
  ENV_ARGS+=(-e OPENAI_API_KEY="$OPENAI_API_KEY")
fi

# Podman-only hardening: keep just the capabilities needed for file handling
# and apt-get; Apple `container` runs each container in its own VM instead.
SEC_ARGS=()

if [ "$ENGINE" = podman ]; then
  SEC_ARGS+=(--security-opt no-new-privileges --cap-drop=ALL --cap-add=CHOWN,DAC_OVERRIDE,FOWNER,FSETID,SETUID,SETGID)
fi

"$ENGINE" run --rm -it \
  -v "$PWD":/workspace -w /workspace \
  -v "$HOME_DIR":/root \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  "${SEC_ARGS[@]+"${SEC_ARGS[@]}"}" \
  codex-cli "$@"
