#!/usr/bin/env bash
# Runs opencode in an isolated container.
# Engine: Apple `container` on macOS, Podman on Linux (rootless Docker fallback).
set -euo pipefail

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  if command -v podman >/dev/null 2>&1; then
            ENGINE=podman
          elif command -v docker >/dev/null 2>&1; then
            if ! docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then
              echo "Docker is not running in rootless mode; container root would be host root." >&2
              echo "Use rootless Docker (dockerd-rootless-setuptool.sh install) or Podman instead." >&2
              exit 1
            fi
            ENGINE=docker
          else
            echo "No container engine found. Install podman (or docker) on Linux." >&2; exit 1
          fi
          ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

HOME_DIR="$HOME/.cli-tools/opencode-home"
mkdir -p "$HOME_DIR"

# opencode keeps a single service registration (service.json) in its state dir.
# Sharing it between containers makes each instance kill the other's server, so
# every run gets its own temporary state dir, removed on exit.
# Per-user state (model selection, prompt history) must survive runs, so it is
# seeded from the shared state dir below and saved back on exit. service.json,
# latest/ and locks/ stay per-run: they can't be shared between instances.
SHARED_DIR="$HOME_DIR/.local/state/opencode"
mkdir -p "$HOME_DIR/.local/state" "$SHARED_DIR"
# Named after this script's PID so orphaned dirs are easy to spot (PID not running).
STATE_DIR="$HOME_DIR/.local/state/opencode-$$"
rm -rf "$STATE_DIR"   # stale leftover from a previous process that had the same PID
mkdir -p "$STATE_DIR"

save_state() {
  for FILE in model.json prompt-history.jsonl; do
    # cmp fails when the shared copy doesn't exist yet, which still means "differ".
    if [ -f "$STATE_DIR/$FILE" ] && ! cmp -s "$STATE_DIR/$FILE" "$SHARED_DIR/$FILE" 2>/dev/null; then
      cp -p "$STATE_DIR/$FILE" "$SHARED_DIR/$FILE"
    fi
  done
  rm -rf "$STATE_DIR"
}
trap save_state EXIT

for FILE in model.json prompt-history.jsonl; do
  if [ -f "$SHARED_DIR/$FILE" ]; then
    cp -p "$SHARED_DIR/$FILE" "$STATE_DIR/$FILE"
  fi
done

# Mount the project at a path unique to this host folder, so tools that keep
# per-project state by path (sessions, trust, memory) don't mix projects.
HOST_DIR="$(pwd -P)"
if command -v sha256sum >/dev/null 2>&1; then
  HASH="$(printf '%s' "$HOST_DIR" | sha256sum | cut -c1-12)"
else
  HASH="$(printf '%s' "$HOST_DIR" | shasum -a 256 | cut -c1-12)"
fi
NAME="$(basename "$HOST_DIR")"
WORKDIR="/workspace/$HASH/${NAME//[^A-Za-z0-9._-]/_}"

ENV_ARGS=()

if [ -n "${TERM:-}" ]; then
  ENV_ARGS+=(-e TERM="$TERM")
fi

if [ -n "${COLORTERM:-}" ]; then
  ENV_ARGS+=(-e COLORTERM="$COLORTERM")
fi

if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  ENV_ARGS+=(-e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY}")
fi

if [ -n "${GEMINI_API_KEY:-}" ]; then
  ENV_ARGS+=(-e GEMINI_API_KEY="${GEMINI_API_KEY}")
fi

if [ -n "${GOOGLE_API_KEY:-}" ]; then
  ENV_ARGS+=(-e GOOGLE_API_KEY="${GOOGLE_API_KEY}")
fi

if [ -n "${GOOGLE_GENAI_USE_VERTEXAI:-}" ]; then
  ENV_ARGS+=(-e GOOGLE_GENAI_USE_VERTEXAI="${GOOGLE_GENAI_USE_VERTEXAI}")
fi

# Linux hardening (Podman or Docker): keep just the capabilities needed for
# file handling and apt-get; Apple `container` runs each container in its
# own VM instead.
SEC_ARGS=()
RUN_ARGS=()

if [ "$ENGINE" != container ]; then
  SEC_ARGS+=(--security-opt no-new-privileges --cap-drop=ALL --cap-add=CHOWN,DAC_OVERRIDE,FOWNER,FSETID,SETUID,SETGID)
else
  RUN_ARGS+=(--progress none)
fi

"$ENGINE" run --rm -it \
  "${RUN_ARGS[@]+"${RUN_ARGS[@]}"}" \
  -v "$HOST_DIR":"$WORKDIR" -w "$WORKDIR" \
  -v "$HOME_DIR":/root \
  -v "$STATE_DIR":/root/.local/state/opencode \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  "${SEC_ARGS[@]+"${SEC_ARGS[@]}"}" \
  opencode-cli "$@"
