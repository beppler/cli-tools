#!/usr/bin/env bash
# Builds the isolated CLI images and installs the wrapper scripts.
# Builds every tool by default, or only the ones named as arguments:
#   ./build            # all tools
#   ./build claude agy # just these
# Pass --scripts-only to install the wrapper scripts without rebuilding images:
#   ./build --scripts-only [tools]
# Auto-detects the engine: Apple `container` on macOS, Podman on Linux.
# On Windows, use build.ps1 instead.
set -euo pipefail
cd "$(dirname "$0")"

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  ENGINE=podman ;;
  *) echo "Unsupported OS: $(uname -s). Use build.ps1 on Windows." >&2; exit 1 ;;
esac

SCRIPTS_ONLY=0
args=()
for arg in "$@"; do
  case "$arg" in
    --scripts-only) SCRIPTS_ONLY=1 ;;
    *) args+=("$arg") ;;
  esac
done

if [ "$SCRIPTS_ONLY" = 0 ] && [ "$ENGINE" = "container" ]; then
  container system start >/dev/null 2>&1 || true
  # container build runs its BuildKit builder under Rosetta regardless of
  # target architecture; install it once if missing, or `container build`
  # fails with "Rosetta is not installed" even for native arm64 images.
  if ! pkgutil --pkg-info com.apple.pkg.RosettaUpdateAuto >/dev/null 2>&1; then
    echo "Installing Rosetta 2 (required by container's build tool)..."
    softwareupdate --install-rosetta --agree-to-license
  fi
fi

all_tools=("agy" "claude" "codex" "copilot" "opencode")

if [ "${#args[@]}" -gt 0 ]; then
  tools=("${args[@]}")
  for tool in "${tools[@]}"; do
    case " ${all_tools[*]} " in
      *" $tool "*) ;;
      *) echo "Unknown tool: $tool (available: ${all_tools[*]})" >&2; exit 1 ;;
    esac
  done
else
  tools=("${all_tools[@]}")
fi

if [ "$SCRIPTS_ONLY" = 0 ]; then
  for tool in "${tools[@]}"; do
    "$ENGINE" build --no-cache -t $tool-cli ./containers/$tool
  done
fi

mkdir -p "$HOME/.local/bin"
cp "${tools[@]/#/bin/}" "$HOME/.local/bin/"

echo "Done ($ENGINE). Make sure \$HOME/.local/bin is on your PATH, then just run: $(IFS=" "; echo "${tools[*]}")"
