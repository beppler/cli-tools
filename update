#!/usr/bin/env bash
# Rebuilds all images with the latest npm package versions.
# --no-cache bypasses layer caching so `npm install -g` actually re-runs.
set -euo pipefail
cd "$(dirname "$0")"

case "$(uname -s)" in
  Darwin) ENGINE=container ;;
  Linux)  ENGINE=podman ;;
  *) echo "Unsupported OS: $(uname -s). Use update.ps1 on Windows." >&2; exit 1 ;;
esac

"$ENGINE" build --no-cache -t claude-cli ./claude
"$ENGINE" build --no-cache -t codex-cli ./codex
"$ENGINE" build --no-cache -t copilot-cli ./copilot
"$ENGINE" build --no-cache -t gemini-cli ./gemini
"$ENGINE" build --no-cache -t opencode-cli ./opencode

echo "Updated ($ENGINE). Wrapper scripts need no changes."
